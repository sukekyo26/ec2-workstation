#!/bin/bash
set -eux

# ============================================================
# EC2 Remote Workstation - User Data Script
# Ubuntu / Debian / Amazon Linux 共通の初期化スクリプト
# (選択できる OS は workstation-config.schema.json の os を参照)
# ============================================================

# ログ設定
exec > >(tee /var/log/user-data.log | logger -t user-data -s 2> /dev/console) 2>&1

echo "=========================================="
echo "Starting EC2 Remote Workstation Setup"
echo "Date: $(date)"
echo "=========================================="

# 環境変数設定
export DEBIAN_FRONTEND=noninteractive
export HOME=/root

# OS 判定 (/etc/os-release の ID でパッケージマネージャを切り替える)
# shellcheck disable=SC1091
. /etc/os-release
case "$ID" in
    ubuntu | debian) PKG_MANAGER=apt ;;
    amzn) PKG_MANAGER=dnf ;;
    *)
        echo "ERROR: unsupported OS '$ID'. Choose an os listed in workstation-config.schema.json." >&2
        exit 1
        ;;
esac

# Amazon Linux の minimal AMI と Debian 公式 AMI には SSM Agent が入っておらず、Session Manager で接続できないため入れる。
# 更新やパッケージの導入が失敗して止まっても SSM で入ってログを見られるよう、それらより先に入れる
# (Debian の curl・dpkg・ca-certificates は AMI に入っている)。
# Ubuntu は snap で入っていて、unit 名も違い、/snap/bin が PATH に無いと command -v で見えないので対象から外す
if [ "$ID" != ubuntu ] && ! command -v amazon-ssm-agent &> /dev/null; then
    case "$ID" in
        amzn)
            dnf install -y amazon-ssm-agent
            ;;
        debian)
            # LIMIT: パッケージの署名は検証せず、AWS 公式の S3 から HTTPS で取るだけ。署名の検証が求められたら作り直す
            IMDS_TOKEN=$(curl -fsS -X PUT http://169.254.169.254/latest/api/token -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
            AWS_REGION=$(curl -fsS -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" http://169.254.169.254/latest/meta-data/placement/region)
            curl -fsSL "https://s3.$AWS_REGION.amazonaws.com/amazon-ssm-$AWS_REGION/latest/debian_amd64/amazon-ssm-agent.deb" -o /tmp/amazon-ssm-agent.deb
            dpkg -i /tmp/amazon-ssm-agent.deb
            rm -f /tmp/amazon-ssm-agent.deb
            ;;
    esac
    systemctl enable --now amazon-ssm-agent
fi

# システムアップデート
echo "[1/7] Updating system packages..."
if [ "$PKG_MANAGER" = apt ]; then
    apt-get update -y
    apt-get upgrade -y
else
    dnf upgrade -y
fi

# 基本ツールインストール
echo "[2/7] Installing essential tools..."
if [ "$PKG_MANAGER" = apt ]; then
    apt-get install -y \
        curl \
        wget \
        git \
        vim \
        nano \
        htop \
        tree \
        jq \
        bc \
        unzip \
        zip \
        tar \
        gzip \
        ca-certificates \
        gnupg \
        lsb-release \
        uuid-runtime \
        build-essential \
        apt-transport-https \
        bind9-dnsutils \
        iputils-ping \
        net-tools \
        e2fsprogs
else
    # curl は AMI 同梱の curl-minimal を使う (curl パッケージは競合する)。
    # wget は AL2027 のリポジトリに無いため入れない。
    dnf install -y \
        git \
        vim-enhanced \
        nano \
        htop \
        tree \
        jq \
        bc \
        unzip \
        zip \
        tar \
        gzip \
        ca-certificates \
        gcc \
        gcc-c++ \
        make \
        bind-utils \
        iputils \
        net-tools \
        util-linux \
        e2fsprogs \
        policycoreutils-python-utils
fi

# データボリュームのマウント
# AMI 更新でルートボリュームが作り直されても残すデータ (~/work・Docker・~/.gitconfig) を置く。
# Docker インストールより前に bind mount しておき、最初からデータボリュームに書かせる。
echo "[3/7] Mounting data volume..."
# shellcheck disable=SC2154 # tofu の templatefile で埋め込まれる
DATA_VOLUME_ID="${data_volume_id}"
# shellcheck disable=SC2154 # 同上
WORKSTATION_USER="${username}"
# shellcheck disable=SC2154 # 同上 (os-images.json の login_user)
DEFAULT_USER="${login_user}"
# user-data はインスタンスで 1 回しか走らないため、直した後は作り直して走らせ直すしかない
print_recreate_hint() {
    echo "  tofu apply -replace='module.workstation[\"$WORKSTATION_USER\"].aws_instance.this'" >&2
}
DATA_MOUNT=/data
# 既定ユーザーは cloud-init が user-data より前に作る
if ! DEFAULT_PASSWD=$(getent passwd "$DEFAULT_USER"); then
    echo "ERROR: login user '$DEFAULT_USER' does not exist. Fix login_user for this OS in opentofu/modules/workstation/os-images.json." >&2
    exit 1
fi
DEFAULT_HOME=$(echo "$DEFAULT_PASSWD" | cut -d: -f6)

# アタッチはインスタンス起動後に行われるため、デバイスが現れるまで待つ。
# Nitro は NVMe シリアル (ボリューム ID からハイフンを除いたもの)、Xen は /dev/xvdf で見える。
DATA_DEVICE=""
for _ in $(seq 1 120); do
    for candidate in "/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$(echo "$DATA_VOLUME_ID" | tr -d -)" /dev/xvdf; do
        if [ -b "$candidate" ]; then
            DATA_DEVICE=$(readlink -f "$candidate")
            break 2
        fi
    done
    sleep 5
done
if [ -z "$DATA_DEVICE" ]; then
    echo "ERROR: data volume $DATA_VOLUME_ID was not attached within 10 minutes, so nothing was mounted or installed." >&2
    echo "Check aws_volume_attachment in the tofu apply output, then recreate the instance:" >&2
    print_recreate_hint
    exit 1
fi

# ファイルシステムが無いとき (初回) だけフォーマットする。既存データは上書きしない。
# blkid -p は「何も見つからない」ときだけでなく、読めないときも 2 を返す (man の EXIT STATUS)。
# 読めないデバイスを空と取り違えないよう、先に先頭を実際に読めることを確かめる (読めなければ set -e で止まる)
dd if="$DATA_DEVICE" of=/dev/null bs=1M count=1 status=none
if DATA_FS_TYPE=$(blkid -p -o value -s TYPE "$DATA_DEVICE"); then
    BLKID_STATUS=0
else
    BLKID_STATUS=$?
fi
case "$BLKID_STATUS" in
    0)
        if [ "$DATA_FS_TYPE" != ext4 ]; then
            echo "ERROR: data volume $DATA_VOLUME_ID has '$DATA_FS_TYPE', not ext4. Refusing to mount or format it; inspect it with 'sudo blkid -p $DATA_DEVICE'." >&2
            exit 1
        fi
        ;;
    2) mkfs.ext4 -q "$DATA_DEVICE" ;;
    *)
        echo "ERROR: blkid -p failed on $DATA_DEVICE (exit $BLKID_STATUS). Refusing to format it; inspect it with 'sudo blkid -p $DATA_DEVICE' and 'sudo wipefs $DATA_DEVICE'." >&2
        exit 1
        ;;
esac
DATA_UUID=$(blkid -o value -s UUID "$DATA_DEVICE")

mkdir -p "$DATA_MOUNT"
if ! grep -q "$DATA_UUID" /etc/fstab; then
    echo "UUID=$DATA_UUID $DATA_MOUNT ext4 defaults,nofail 0 2" >> /etc/fstab
fi
mountpoint -q "$DATA_MOUNT" || mount "$DATA_MOUNT"
# ボリュームを拡張した場合に追従する (サイズが同じなら何もしない)
resize2fs "$DATA_DEVICE"

for dir in work docker containerd; do
    if [ ! -d "$DATA_MOUNT/$dir" ]; then
        mkdir -p "$DATA_MOUNT/$dir"
        if [ "$dir" = work ]; then
            chown "$DEFAULT_USER:$DEFAULT_USER" "$DATA_MOUNT/$dir"
        fi
    fi
done

# 持ち主は UID で決まる。OS を変えて既定ユーザーの UID が変わったときは、新しいユーザーに合わせる
# (/data/git は git の設定の所で毎回そろえる)
if [ "$(stat -c %u "$DATA_MOUNT/work")" != "$(id -u "$DEFAULT_USER")" ]; then
    chown -R "$DEFAULT_USER:" "$DATA_MOUNT/work"
fi

# containerd image store (Docker 29 以降の既定) は /var/lib/docker とは別に
# /var/lib/containerd へイメージを置くため、両方をデータボリュームに向ける
for target in "$DEFAULT_HOME/work:work" /var/lib/docker:docker /var/lib/containerd:containerd; do
    mount_point=$(echo "$target" | cut -d: -f1)
    source_dir="$DATA_MOUNT/$(echo "$target" | cut -d: -f2)"
    mkdir -p "$mount_point"
    # nofail のため、データボリュームが無いまま起動しても SSM では入れる。そのとき ~/work が
    # ルートボリュームに黙って書かれ、次の作り直しで消えないよう、下地のディレクトリを書き込み禁止にする。
    # Docker は RequiresMountsFor でマウント前に起動しないので対象外
    if [ "$mount_point" = "$DEFAULT_HOME/work" ] && ! mountpoint -q "$mount_point"; then
        chattr +i "$mount_point"
    fi
    if ! grep -q " $mount_point none bind" /etc/fstab; then
        echo "$source_dir $mount_point none bind,nofail,x-systemd.requires-mounts-for=$DATA_MOUNT 0 0" >> /etc/fstab
    fi
    mountpoint -q "$mount_point" || mount "$mount_point"
done
chown "$DEFAULT_USER:$DEFAULT_USER" "$DEFAULT_HOME/work"

# 再起動時にマウント完了前に Docker が起動して空のディレクトリへ書き込まないようにする
for unit in docker containerd; do
    mkdir -p "/etc/systemd/system/$unit.service.d"
    cat > "/etc/systemd/system/$unit.service.d/data-volume.conf" << 'UNIT'
[Unit]
RequiresMountsFor=/var/lib/docker /var/lib/containerd
UNIT
done
systemctl daemon-reload

# git の設定 (git config --global) は、データボリューム上の既定ユーザーの持ち物のディレクトリに置き、
# ~/.gitconfig をそこへのシンボリックリンクにする。git はリンク先と同じディレクトリにロックファイルを
# 作るので、root の持ち物の /data の直下に置くと書き込めない
DATA_GIT_DIR="$DATA_MOUNT/git"
DATA_GIT_CONFIG="$DATA_GIT_DIR/config"
OLD_DATA_GIT_CONFIG="$DATA_MOUNT/gitconfig"
# root が mv や chown でリンクの先 (データボリュームの外) を触らないよう、リンクは断る (user-data はリンクを作らない)
for path in "$DATA_GIT_DIR" "$DATA_GIT_CONFIG" "$OLD_DATA_GIT_CONFIG"; do
    if [ -L "$path" ]; then
        echo "ERROR: $path is a symbolic link. Replace it with a regular file or directory, then recreate the instance:" >&2
        print_recreate_hint
        exit 1
    fi
done
mkdir -p "$DATA_GIT_DIR"
# 古い置き場所 (/data/gitconfig) からの移行。何度走っても同じ結果になる
# LIMIT: PR #3 の版で作った環境が全部作り直されたら、この移行の分岐を消す
if [ -e "$OLD_DATA_GIT_CONFIG" ]; then
    if [ ! -e "$DATA_GIT_CONFIG" ]; then
        mv "$OLD_DATA_GIT_CONFIG" "$DATA_GIT_CONFIG"
    elif [ ! -s "$OLD_DATA_GIT_CONFIG" ] || cmp -s "$OLD_DATA_GIT_CONFIG" "$DATA_GIT_CONFIG"; then
        rm -f "$OLD_DATA_GIT_CONFIG"
    else
        echo "ERROR: both $OLD_DATA_GIT_CONFIG and $DATA_GIT_CONFIG exist with different contents." >&2
        echo "Decide which to keep (merge into $DATA_GIT_CONFIG if needed), delete the other, then recreate the instance:" >&2
        print_recreate_hint
        exit 1
    fi
fi
# user-data は既定ユーザーの git より先に走るので、残った config.lock は前のインスタンスの途中のもの (git は消さずに断る)。
# 途中で SSM から入って git を打つと生きたロックを消しうるが、その git の rename が失敗するだけで config は壊れない
rm -f "$DATA_GIT_DIR/config.lock"
touch "$DATA_GIT_CONFIG"
# 中に置かれたファイル (残った lock など) の持ち主もそろえる (-R の既定 -P で、中のリンクの先はたどらない)
chown -R "$DEFAULT_USER:" "$DATA_GIT_DIR"
ln -sfn "$DATA_GIT_CONFIG" "$DEFAULT_HOME/.gitconfig"
chown -h "$DEFAULT_USER:" "$DEFAULT_HOME/.gitconfig"

# Dockerインストール
echo "[4/7] Installing Docker..."
# GitHub の docker/<repo> の最新リリースから CLI プラグインを入れる。
# 本体と checksums.txt を同じタグから取り、sha256 が合わなければ (行が無いときも) set -e で止める
install_cli_plugin() {
    local repo=$1 asset_pattern=$2 name=$3 tag asset dir
    tag=$(curl -fsSL "https://api.github.com/repos/docker/$repo/releases/latest" | jq -r .tag_name)
    if [ -z "$tag" ] || [ "$tag" = null ]; then
        echo "ERROR: could not read the latest release tag of docker/$repo from the GitHub API (rate limit or network). Recreate the instance to retry." >&2
        exit 1
    fi
    asset=$(echo "$asset_pattern" | sed "s/TAG/$tag/")
    dir=$(mktemp -d)
    curl -fsSL "https://github.com/docker/$repo/releases/download/$tag/$asset" -o "$dir/$asset"
    curl -fsSL "https://github.com/docker/$repo/releases/download/$tag/checksums.txt" -o "$dir/checksums.txt"
    (cd "$dir" && grep " \*$asset\$" checksums.txt | sha256sum -c -)
    install -D -m 0755 "$dir/$asset" "/usr/local/lib/docker/cli-plugins/$name"
    rm -rf "$dir"
}

if ! command -v docker &> /dev/null; then
    if [ "$PKG_MANAGER" = apt ]; then
        # イメージの置き場所を containerd image store に固定する。OS を変えて /var/lib/docker に
        # 既存の overlay2 データがあると、既定でも overlay2 に倒れるため明示する。
        # LIMIT: docker 29.9.2 はこの鍵を「既定なので不要」と warning にする。廃止されて dockerd が起動しなくなったら、置き場所を固定する別の手段に替える
        mkdir -p /etc/docker
        echo '{"features": {"containerd-snapshotter": true}}' > /etc/docker/daemon.json
        # Docker公式インストールスクリプトを使用
        curl -fsSL https://get.docker.com -o /tmp/get-docker.sh
        sh /tmp/get-docker.sh
        rm -f /tmp/get-docker.sh
    else
        # Amazon Linux は公式スクリプト非対応のため OS 同梱の docker を使う。
        # Compose / buildx プラグインは同梱されないので GitHub の最新リリースを入れる
        dnf install -y docker
        install_cli_plugin compose docker-compose-linux-x86_64 docker-compose
        install_cli_plugin buildx buildx-TAG.linux-amd64 docker-buildx
    fi
fi

# SELinux 有効時 (Amazon Linux。AL2027 は enforcing が既定) は、データボリューム上のファイルに
# 本来のパスと同じラベルを付ける。付けないと Docker やログインユーザーがアクセスを拒否される。
# 真似る元の /var/lib/docker・/var/lib/containerd の規則は container-selinux (docker の依存) が
# 入れるため、Docker を入れた後・起動する前に付ける。
# LIMIT: インスタンス作成のたびに /data 全体を再ラベルする。ファイル数が増えて起動が遅くなったら対象を絞る
if command -v selinuxenabled &> /dev/null && selinuxenabled; then
    semanage fcontext -a -e "$DEFAULT_HOME/work" "$DATA_MOUNT/work"
    semanage fcontext -a -e /var/lib/docker "$DATA_MOUNT/docker"
    semanage fcontext -a -e /var/lib/containerd "$DATA_MOUNT/containerd"
    # git はロックを rename で置き換えるので、書くたびに新しい inode ができ、ラベルは親から受け継がれる。
    # そのためファイルではなく /data/git のディレクトリを、ホームのディレクトリと等価にする
    semanage fcontext -a -e "$DEFAULT_HOME" "$DATA_MOUNT/git"
    restorecon -R "$DATA_MOUNT"
fi

systemctl enable --now docker

# デフォルトユーザーをdockerグループに追加
usermod -aG docker "$DEFAULT_USER"

# Docker Compose確認
echo "Docker version:"
docker --version
echo "Docker Compose version:"
docker compose version

# AWS CLI v2インストール
echo "[5/7] Installing AWS CLI v2..."
if ! command -v aws &> /dev/null; then
    cd /tmp
    curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip"
    unzip -q awscliv2.zip
    ./aws/install
    rm -rf aws awscliv2.zip
fi
echo "AWS CLI version:"
aws --version

# sudoヘルプメッセージを非表示にする (Ubuntu のみ表示される)
echo "[6/7] Configuring user environment..."
if [ "$ID" = ubuntu ]; then
    touch "$DEFAULT_HOME/.sudo_as_admin_successful"
    chown "$DEFAULT_USER:$DEFAULT_USER" "$DEFAULT_HOME/.sudo_as_admin_successful"
fi

# タイムゾーン設定（日本時間）
echo "[7/7] Setting timezone and swap space..."
timedatectl set-timezone Asia/Tokyo

# スワップ領域作成（メモリ不足対策）
if [ ! -f /swapfile ]; then
    fallocate -l 4G /swapfile
    chmod 600 /swapfile
    mkswap /swapfile
    swapon /swapfile
    echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

# 完了メッセージ
echo "=========================================="
echo "EC2 Remote Workstation Setup Complete!"
echo "Date: $(date)"
echo "=========================================="
echo ""
echo "Installed software:"
echo "  - Docker: $(docker --version)"
echo "  - AWS CLI: $(aws --version)"
echo "  - Git: $(git --version)"
echo ""
echo "You can now connect via AWS Systems Manager Session Manager."
if true; then
