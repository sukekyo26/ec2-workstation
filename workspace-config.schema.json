{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workspace Configuration",
  "description": "EC2 Remote Workspace の設定スキーマ",
  "type": "object",
  "required": [
    "users"
  ],
  "properties": {
    "projectName": {
      "type": "string",
      "description": "プロジェクト名（リソース命名に使用）",
      "default": "ec2-remote-workspace",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
    },
    "environment": {
      "type": "string",
      "description": "環境名 (dev, staging, prod)",
      "default": "dev",
      "enum": [
        "dev",
        "staging",
        "prod"
      ]
    },
    "vpcCidr": {
      "type": "string",
      "description": "VPC CIDR",
      "default": "10.0.0.0/16",
      "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"
    },
    "defaultInstanceConfig": {
      "type": "object",
      "description": "デフォルトのEC2インスタンス設定",
      "properties": {
        "instanceType": {
          "type": "string",
          "description": "インスタンスタイプ",
          "default": "t3.medium"
        },
        "volumeSize": {
          "type": "number",
          "description": "EBSボリュームサイズ (GB)",
          "default": 80,
          "minimum": 20,
          "maximum": 1000
        },
        "volumeType": {
          "type": "string",
          "description": "EBSボリュームタイプ",
          "default": "gp3",
          "enum": [
            "gp3",
            "gp2"
          ]
        }
      }
    },
    "enableElasticIp": {
      "type": "boolean",
      "description": "Elastic IP（固定パブリックIP）をデフォルトで全ユーザーに割り当てるか。ユーザーごとに上書き可能。",
      "default": false
    },
    "autoStopConfig": {
      "type": "object",
      "description": "自動停止設定",
      "properties": {
        "cpuThreshold": {
          "type": "number",
          "description": "CPU使用率閾値（%）- この値以下が続くと停止",
          "default": 5,
          "minimum": 1,
          "maximum": 100
        },
        "cpuEvaluationMinutes": {
          "type": "number",
          "description": "CPU監視期間（分）- この期間低負荷が続くと停止",
          "default": 10,
          "minimum": 5,
          "maximum": 60
        },
        "scheduledStopHour": {
          "type": "number",
          "description": "定時停止時刻（時、0-23、Asia/Tokyo）",
          "default": 23,
          "minimum": 0,
          "maximum": 23
        },
        "scheduledStopMinute": {
          "type": "number",
          "description": "定時停止時刻（分、0-59）",
          "default": 0,
          "minimum": 0,
          "maximum": 59
        }
      }
    },
    "users": {
      "type": "array",
      "description": "ワークスペースユーザー一覧",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "username"
        ],
        "properties": {
          "username": {
            "type": "string",
            "description": "ユーザー名（3-32文字、小文字英数字とハイフン・アンダースコア）",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,30}[a-z0-9]$"
          },
          "displayName": {
            "type": "string",
            "description": "表示名（オプション）"
          },
          "instanceConfig": {
            "type": "object",
            "description": "ユーザー固有のインスタンス設定（オプション）",
            "properties": {
              "instanceType": {
                "type": "string"
              },
              "volumeSize": {
                "type": "number",
                "minimum": 20,
                "maximum": 1000
              },
              "volumeType": {
                "type": "string",
                "enum": [
                  "gp3",
                  "gp2"
                ]
              }
            }
          },
          "enableElasticIp": {
            "type": "boolean",
            "description": "Elastic IP（固定パブリックIP）を有効にするか（プロジェクトデフォルトを上書き）"
          }
        }
      }
    }
  }
}
