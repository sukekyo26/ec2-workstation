{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workstation Configuration",
  "description": "EC2 Workstation の設定スキーマ。全項目必須（users[].instanceConfig / users[].enableElasticIp / users[].displayName を除く）。このスキーマが設定の唯一の仕様であり、CI（ajv-cli）で強制される。",
  "type": "object",
  "required": [
    "projectName",
    "environment",
    "vpcCidr",
    "defaultInstanceConfig",
    "autoStopConfig",
    "enableElasticIp",
    "users"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "エディタ補完用のスキーマ参照"
    },
    "projectName": {
      "type": "string",
      "description": "プロジェクト名（リソース命名に使用）",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
    },
    "environment": {
      "type": "string",
      "description": "環境名 (dev, staging, prod)",
      "enum": [
        "dev",
        "staging",
        "prod"
      ]
    },
    "vpcCidr": {
      "type": "string",
      "description": "VPC CIDR",
      "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"
    },
    "defaultInstanceConfig": {
      "type": "object",
      "description": "デフォルトのEC2インスタンス設定",
      "required": [
        "instanceType",
        "volumeSize",
        "volumeType"
      ],
      "additionalProperties": false,
      "properties": {
        "instanceType": {
          "type": "string",
          "description": "インスタンスタイプ (例: t3.medium)"
        },
        "volumeSize": {
          "type": "number",
          "description": "EBSボリュームサイズ (GB)",
          "minimum": 20,
          "maximum": 1000
        },
        "volumeType": {
          "type": "string",
          "description": "EBSボリュームタイプ",
          "enum": [
            "gp3",
            "gp2"
          ]
        }
      }
    },
    "enableElasticIp": {
      "type": "boolean",
      "description": "Elastic IP（固定パブリックIP）をデフォルトで全ユーザーに割り当てるか。ユーザーごとに上書き可能。"
    },
    "autoStopConfig": {
      "type": "object",
      "description": "自動停止設定",
      "required": [
        "cpuThreshold",
        "cpuEvaluationMinutes",
        "scheduledStopHour",
        "scheduledStopMinute"
      ],
      "additionalProperties": false,
      "properties": {
        "cpuThreshold": {
          "type": "number",
          "description": "CPU使用率閾値（%）- この値以下が続くと停止",
          "minimum": 1,
          "maximum": 100
        },
        "cpuEvaluationMinutes": {
          "type": "number",
          "description": "CPU監視期間（分）- この期間低負荷が続くと停止",
          "minimum": 5,
          "maximum": 60
        },
        "scheduledStopHour": {
          "type": "number",
          "description": "定時停止時刻（時、0-23、Asia/Tokyo）",
          "minimum": 0,
          "maximum": 23
        },
        "scheduledStopMinute": {
          "type": "number",
          "description": "定時停止時刻（分、0-59）",
          "minimum": 0,
          "maximum": 59
        }
      }
    },
    "users": {
      "type": "array",
      "description": "ワークステーションユーザー一覧",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "username"
        ],
        "additionalProperties": false,
        "properties": {
          "username": {
            "type": "string",
            "description": "ユーザー名（3-32文字、小文字英数字とハイフン・アンダースコア）",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,30}[a-z0-9]$"
          },
          "displayName": {
            "type": "string",
            "description": "表示名（オプション）"
          },
          "instanceConfig": {
            "type": "object",
            "description": "ユーザー固有のインスタンス設定（オプション、defaultInstanceConfig を項目単位で上書き）",
            "additionalProperties": false,
            "properties": {
              "instanceType": {
                "type": "string"
              },
              "volumeSize": {
                "type": "number",
                "minimum": 20,
                "maximum": 1000
              },
              "volumeType": {
                "type": "string",
                "enum": [
                  "gp3",
                  "gp2"
                ]
              }
            }
          },
          "enableElasticIp": {
            "type": "boolean",
            "description": "Elastic IP（固定パブリックIP）を有効にするか（プロジェクトデフォルトを上書き）"
          }
        }
      }
    }
  }
}
