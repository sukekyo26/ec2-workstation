{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workstation Configuration",
  "description": "EC2 Workstation の設定スキーマ。全項目必須（users[].instanceConfig / users[].enableElasticIp / users[].displayName を除く）。このスキーマが設定の唯一の仕様であり、CI（ajv-cli）で強制される。",
  "type": "object",
  "definitions": {
    "os": {
      "type": "string",
      "description": "OS。デプロイのたびに選んだ OS の最新 AMI に追従する。al2027-preview は Amazon Linux 2027 のプレビュー版で、本番利用は非推奨（GA になったら al2027 を別の値として足す）",
      "enum": [
        "al2023",
        "al2027-preview",
        "ubuntu-24.04",
        "ubuntu-26.04",
        "debian-13"
      ]
    }
  },
  "required": [
    "projectName",
    "environment",
    "awsRegion",
    "vpcCidr",
    "defaultInstanceConfig",
    "autoStopConfig",
    "enableElasticIp",
    "users"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "エディタ補完用のスキーマ参照"
    },
    "projectName": {
      "type": "string",
      "description": "プロジェクト名（リソース命名に使用）",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
    },
    "environment": {
      "type": "string",
      "description": "環境名 (dev, staging, prod)",
      "enum": [
        "dev",
        "staging",
        "prod"
      ]
    },
    "awsRegion": {
      "type": "string",
      "description": "デプロイ先の AWS リージョン（例: ap-northeast-1）。デプロイ後に変えると、既存の環境を見失い、新しいリージョンにもう 1 組作る",
      "pattern": "^[a-z]{2}(-[a-z]+)+-[0-9]$"
    },
    "vpcCidr": {
      "type": "string",
      "description": "VPC CIDR",
      "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"
    },
    "defaultInstanceConfig": {
      "type": "object",
      "description": "デフォルトのEC2インスタンス設定",
      "required": [
        "os",
        "instanceType",
        "rootVolumeSize",
        "rootVolumeType",
        "dataVolumeSize",
        "dataVolumeType"
      ],
      "additionalProperties": false,
      "properties": {
        "os": {
          "$ref": "#/definitions/os"
        },
        "instanceType": {
          "type": "string",
          "description": "インスタンスタイプ (例: t3.medium)。x86_64 のみ対応"
        },
        "rootVolumeSize": {
          "type": "number",
          "description": "ルートEBSボリュームサイズ (GB)。OS とパッケージ用で、AMI 更新のたびに作り直される",
          "minimum": 20,
          "maximum": 1000
        },
        "rootVolumeType": {
          "type": "string",
          "description": "ルートEBSボリュームタイプ",
          "enum": [
            "gp3",
            "gp2"
          ]
        },
        "dataVolumeSize": {
          "type": "number",
          "description": "データEBSボリュームサイズ (GB)。~/work・Docker・~/.gitconfig を保存し、AMI 更新後も残る",
          "minimum": 20,
          "maximum": 1000
        },
        "dataVolumeType": {
          "type": "string",
          "description": "データEBSボリュームタイプ",
          "enum": [
            "gp3",
            "gp2"
          ]
        }
      }
    },
    "enableElasticIp": {
      "type": "boolean",
      "description": "Elastic IP（固定パブリックIP）をデフォルトで全ユーザーに割り当てるか。ユーザーごとに上書き可能。"
    },
    "autoStopConfig": {
      "type": "object",
      "description": "自動停止設定",
      "required": [
        "cpuThreshold",
        "cpuEvaluationMinutes",
        "scheduledStopHour",
        "scheduledStopMinute"
      ],
      "additionalProperties": false,
      "properties": {
        "cpuThreshold": {
          "type": "number",
          "description": "CPU使用率閾値（%）- この値以下が続くと停止",
          "minimum": 1,
          "maximum": 100
        },
        "cpuEvaluationMinutes": {
          "type": "number",
          "description": "CPU監視期間（分）- この期間低負荷が続くと停止",
          "minimum": 5,
          "maximum": 60
        },
        "scheduledStopHour": {
          "type": "number",
          "description": "定時停止時刻（時、0-23、Asia/Tokyo）",
          "minimum": 0,
          "maximum": 23
        },
        "scheduledStopMinute": {
          "type": "number",
          "description": "定時停止時刻（分、0-59）",
          "minimum": 0,
          "maximum": 59
        }
      }
    },
    "users": {
      "type": "array",
      "description": "ワークステーションユーザー一覧",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "username"
        ],
        "additionalProperties": false,
        "properties": {
          "username": {
            "type": "string",
            "description": "ユーザー名（3-32文字、小文字英数字とハイフン・アンダースコア）",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,30}[a-z0-9]$"
          },
          "displayName": {
            "type": "string",
            "description": "表示名（オプション）"
          },
          "instanceConfig": {
            "type": "object",
            "description": "ユーザー固有のインスタンス設定（オプション、defaultInstanceConfig を項目単位で上書き）",
            "additionalProperties": false,
            "properties": {
              "os": {
                "$ref": "#/definitions/os"
              },
              "instanceType": {
                "type": "string"
              },
              "rootVolumeSize": {
                "type": "number",
                "minimum": 20,
                "maximum": 1000
              },
              "rootVolumeType": {
                "type": "string",
                "enum": [
                  "gp3",
                  "gp2"
                ]
              },
              "dataVolumeSize": {
                "type": "number",
                "minimum": 20,
                "maximum": 1000
              },
              "dataVolumeType": {
                "type": "string",
                "enum": [
                  "gp3",
                  "gp2"
                ]
              }
            }
          },
          "enableElasticIp": {
            "type": "boolean",
            "description": "Elastic IP（固定パブリックIP）を有効にするか（プロジェクトデフォルトを上書き）"
          }
        }
      }
    }
  }
}
